<root>
	<Implements>
		<Interface> BaseAndCell </Interface>
	</Implements>

	<Properties>
		<realm>
			<Type>			REALM_ID		</Type>
			<Flags>			BASE			</Flags>
		</realm>

		<spaceName>
			<Type>			STRING			</Type>
			<Flags>			BASE			</Flags>
		</spaceName>

		<!-- Base properties -->
		<label>
			<Type>			STRING			</Type>
			<Flags>			BASE			</Flags>
			<Persistent>	true			</Persistent>
			<Editable>		true			</Editable>
		</label>

		<dstPos>
			<Type>			VECTOR3			</Type>
			<Flags>			BASE			</Flags>
			<Persistent>	true			</Persistent>
		</dstPos>

	</Properties>

	<ClientMethods>
	</ClientMethods>

	<BaseMethods>
	</BaseMethods>

	<CellMethods>
		<tryToTeleport>
			<Arg>	STRING	 </Arg>	<!-- Space name -->
			<Arg>	STRING	 </Arg>	<!-- Point name -->
			<Arg> 	MAILBOX   </Arg>
			<Arg> 	INT32	 </Arg>
		</tryToTeleport>
	</CellMethods>
</root>
