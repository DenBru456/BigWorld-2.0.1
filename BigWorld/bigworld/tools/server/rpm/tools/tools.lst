# 
# File list for server tools.
# 
# If editing this, note that more specific file paths should come before
# shorter file paths.
# 
# For example, if you are including bigworld/tools/server/space_viewer with
# mode of 644, but you want space_viewer.py within that directory to be mode
# 0755, add it before the space_viewer directory.
#

excludePathPatterns \.swp$
excludePathPatterns \.svn
excludePathPatterns \.nfs

excludePathPatterns bigworld/tools/server/web_console/common/static/js/dojo/
excludePathPatterns bigworld/tools/server/web_console/stat_grapher/
excludePathPatterns bigworld/tools/server/bin/Hybrid/
excludePathPatterns bigworld/tools/server/bin/Hybrid64/(bwmachined2|mls|runscript|snapshot_helper|watcher)
excludePathPatterns bigworld/tools/bwlockd/bwlockd_test.py

add bigworld/tools/server/install/profile.tools.sh,%{_sysconfdir}/profile.d/bw-tools.sh,0755

addConfig bigworld/tools/server/install/bigworld.conf.sample,%{_sysconfdir}/bigworld.conf,0644,bwtools,bwtools

add bigworld/tools/server/bin/%{mf_config}/__init__.py,%{bigworld_tools_dir}/bin/%{mf_config}/__init__.py,0444,bwtools,bwtools
add bigworld/tools/server/bin/%{mf_config}/__init__.pyc,%{bigworld_tools_dir}/bin/%{mf_config}/__init__.pyc,0444,bwtools,bwtools
add bigworld/tools/server/bin/%{mf_config},%{bigworld_tools_dir}/bin/%{mf_config},0554,bwtools,bwtools
add bigworld/tools/server/bin/__init__.py,%{bigworld_tools_dir}/bin/__init__.py,0444,bwtools,bwtools
add bigworld/tools/server/bin/__init__.pyc,%{bigworld_tools_dir}/bin/__init__.pyc,0444,bwtools,bwtools

add bigworld/tools/server/pycommon,%{bigworld_tools_dir}/pycommon,0444,bwtools,bwtools
add bigworld/tools/server/cluster_commands,%{bigworld_tools_dir}/cluster_commands,0444,bwtools,bwtools

add bigworld/tools/server/control_cluster.py,%{bigworld_tools_dir}/control_cluster.py,0555,bwtools,bwtools
add bigworld/tools/server/bot_op.py,%{bigworld_tools_dir}/bot_op.py,0555,bwtools,bwtools

add bigworld/tools/server/space_viewer/space_viewer.py,%{bigworld_tools_dir}/space_viewer/space_viewer.py,0555,bwtools,bwtools
add bigworld/tools/server/space_viewer/svlogger.py,%{bigworld_tools_dir}/space_viewer/svlogger.py,0555,bwtools,bwtools
add bigworld/tools/server/space_viewer,%{bigworld_tools_dir}/space_viewer,0444,bwtools,bwtools

add bigworld/tools/server/message_logger/mlcat.py,%{bigworld_tools_dir}/message_logger/mlcat.py,0555,bwtools,bwtools
add bigworld/tools/server/message_logger/mlls.py,%{bigworld_tools_dir}/message_logger/mlls.py,0555,bwtools,bwtools
add bigworld/tools/server/message_logger/mlrm.py,%{bigworld_tools_dir}/message_logger/mlrm.py,0554,bwtools,bwtools
add bigworld/tools/server/message_logger/mlroll.py,%{bigworld_tools_dir}/message_logger/mlroll.py,0554,bwtools,bwtools
add bigworld/tools/server/message_logger/mlsum.py,%{bigworld_tools_dir}/message_logger/mlsum.py,0555,bwtools,bwtools
add bigworld/tools/server/message_logger/mltar.py,%{bigworld_tools_dir}/message_logger/mltar.py,0555,bwtools,bwtools
add bigworld/tools/server/message_logger/message_logger.conf,%{bigworld_tools_dir}/message_logger/message_logger.conf.example,0444,bwtools,bwtools
addConfig bigworld/tools/server/message_logger/message_logger.conf,%{bigworld_conf_dir}/message_logger.conf,0644,bwtools,bwtools
add bigworld/tools/server/message_logger,%{bigworld_tools_dir}/message_logger,0444,bwtools,bwtools

# add bigworld/tools/server/snapshot/snapshot.py,%{bigworld_tools_dir}/snapshot/snapshot.py,0555,bwtools,bwtools
# add bigworld/tools/server/snapshot,%{bigworld_tools_dir}/snapshot,0444,bwtools,bwtools

# add bigworld/tools/server/stat_logger/stat_logger.py,%{bigworld_tools_dir}/stat_logger/stat_logger.py,0554,bwtools,bwtools
# add bigworld/tools/server/stat_logger,%{bigworld_tools_dir}/stat_logger,0444,bwtools,bwtools

add bigworld/tools/server/web_console/common/static/js,%{bigworld_tools_dir}/web_console/common/static/js,0744,bwtools,bwtools
add bigworld/tools/server/web_console/start-web_console.py,%{bigworld_tools_dir}/web_console/start-web_console.py,0554,bwtools,bwtools
addConfig bigworld/tools/server/install/web_console.cfg,%{bigworld_conf_dir}/web_console.conf,0644,bwtools,bwtools
add bigworld/tools/server/web_console,%{bigworld_tools_dir}/web_console,0444,bwtools,bwtools

add bigworld/tools/bwlockd/bwlockd.py,%{bigworld_tools_dir}/bwlockd/bwlockd.py,0554,bwtools,bwtools
add bigworld/tools/bwlockd,%{bigworld_tools_dir}/bwlockd,0444,bwtools,bwtools

add bigworld/tools/server/install/bw_functions.sh,%{bigworld_initrd_dir}/bw_functions,0444
add bigworld/tools/server/install/web_console.sh,%{bigworld_initrd_dir}/bw_web_console,0555
add bigworld/tools/server/install/message_logger.sh,%{bigworld_initrd_dir}/bw_message_logger,0555
# add bigworld/tools/server/install/stat_logger.sh,%{bigworld_initrd_dir}/bw_stat_logger,0555
add bigworld/tools/server/install/bwlockd.sh,%{bigworld_initrd_dir}/bw_lockd,0555
add bigworld/tools/server/install/bw_web_console_access.cron,%{cron_hourly_dir}/bw_web_console_access,0554

# logrotate scripts
addConfig bigworld/tools/server/message_logger/message_logger.logrotate,%{logrotate_dir}/bw_message_logger,0644
addConfig bigworld/tools/server/install/bw_server_tools.logrotate,%{logrotate_dir}/bw_server_tools,0644

filter %{logrotate_dir}/bw_message_logger |sed 's#<default_archive>#%{message_logger_dir}/message_logs.tar.gz#'

filter %{logrotate_dir}/bw_message_logger |sed 's#/sbin/service.*logrotate#su -c "&" %{bw_tools_user}#'
filter %{logrotate_dir}/bw_server_tools |sed 's#/sbin/service.*logrotate#su -c "&" %{bw_tools_user}#'

# Create the links in /etc/init.d
link %{bigworld_initrd_dir}/bw_web_console,%{_initrddir}/bw_web_console,0555
link %{bigworld_initrd_dir}/bw_message_logger,%{_initrddir}/bw_message_logger,0555
# link %{bigworld_initrd_dir}/bw_stat_logger,%{_initrddir}/bw_stat_logger,0555
link %{bigworld_initrd_dir}/bw_lockd,%{_initrddir}/bw_lockd,0555

filter %{_sysconfdir}/bigworld.conf  |sed 's#location = .*#location = %{bigworld_tools_dir}#'
filter %{_sysconfdir}/bigworld.conf  |sed 's#piddir = .*#piddir = %{pid_dir}#'

filter %{bigworld_initrd_dir}/bw_functions  |sed 's#export BW_TOOLS_PIDDIR=.*#export BW_TOOLS_PIDDIR="%{pid_dir}"#'
filter %{bigworld_initrd_dir}/bw_functions  |sed 's#export BW_TOOLS_USERNAME=.*#export BW_TOOLS_USERNAME="%{bw_tools_user}"#'
filter %{bigworld_initrd_dir}/bw_functions  |sed 's#export BW_TOOLS_GROUPNAME=.*#export BW_TOOLS_GROUPNAME="%{bw_tools_user}"#'
filter %{bigworld_initrd_dir}/bw_functions  |sed 's#export BW_TOOLS_DIR=.*#export BW_TOOLS_DIR="%{bigworld_tools_dir}"#'
filter %{bigworld_initrd_dir}/bw_functions  |sed 's#export BW_TOOLS_BIN=.*#export BW_TOOLS_BIN="%{bigworld_tools_dir}/bin/Hybrid64"#'
filter %{bigworld_initrd_dir}/bw_functions  |sed 's#export BW_TOOLS_LOG_DIR=.*#export BW_TOOLS_LOG_DIR="%{daemon_log_dir}"#'

filter %{bigworld_initrd_dir}/bw_message_logger  |sed 's#. /etc/init.d/bw_functions#. %{bigworld_initrd_dir}/bw_functions#'
filter %{bigworld_initrd_dir}/bw_message_logger  |sed 's#CONFFILE=.*#CONFFILE=%{bigworld_conf_dir}/message_logger.conf#'

filter %{bigworld_initrd_dir}/bw_web_console  |sed 's#. /etc/init.d/bw_functions#. %{bigworld_initrd_dir}/bw_functions#'
filter %{bigworld_initrd_dir}/bw_web_console  |sed 's#WEB_CONSOLE_CONF=.*#WEB_CONSOLE_CONF=%{bigworld_conf_dir}/web_console.conf#'

# filter %{bigworld_initrd_dir}/bw_stat_logger  |sed 's#. /etc/init.d/bw_functions#. %{bigworld_initrd_dir}/bw_functions#'

filter %{bigworld_initrd_dir}/bw_lockd  |sed 's#BWLOCKD_HOME=.*#BWLOCKD_HOME=%{bigworld_tools_dir}/bwlockd#'
filter %{bigworld_initrd_dir}/bw_lockd  |sed 's#INIT_RD_DIR=.*#INIT_RD_DIR="%{bigworld_initrd_dir}"#'

filter %{bigworld_conf_dir}/message_logger.conf  |sed 's#default_archive.*#default_archive = %{message_logger_dir}/message_logs.tar.gz#'
filter %{bigworld_conf_dir}/message_logger.conf  |sed 's#logdir.*#logdir = %{message_logger_dir}#'
filter %{bigworld_conf_dir}/web_console.conf     |sed 's~###BW_SQLURI###~sqlobject.dburi="sqlite://%{sqlite_db_dir}/web_console.sqlite"~'

# Disable StatGrapher (TODO: should be for Indie package only)
filter %{bigworld_tools_dir}/web_console/root/controllers.py  |sed 's#^ENABLE_STAT_GRAPHER =.*#ENABLE_STAT_GRAPHER = False#'

# BWLockD has been repositioned in the directory hierachy, so needs to look in a different location
filter %{bigworld_tools_dir}/bwlockd/bwlockd.py  |sed 's#bwsetup.addPath( "../server" )#bwsetup.addPath( ".." )#'

link %{bigworld_tools_dir},%{bigworld_current_dir}/tools,0555

dir %{bigworld_dir},555
dir %{bigworld_current_dir},555
dir /opt/bigworld,555

dir %{bigworld_tools_dir},0555,bwtools,bwtools
dir %{bigworld_tools_dir}/init.d,0555,bwtools,bwtools
dir %{bigworld_tools_dir}/bin,0555,bwtools,bwtools

dir %{bigworld_conf_dir},0644,bwtools,bwtools
dir %{pid_dir},0644
